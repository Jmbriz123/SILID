# Application database: all five DB_* values are required.
# Host processes use localhost and the published port.
# Inside Compose, set DB_HOST=postgres and DB_PORT=5432 explicitly (Step 2).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=silid
DB_USER=silid
DB_PASSWORD=local-development-only

# Public, non-secret weather settings. The MVP uses Asia/Manila.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
TIMEZONE=Asia/Manila

# Legacy Compose bootstrap settings, NOT application configuration fallbacks.
# Distinct application/metadata databases and least-privilege roles arrive in Step 2.
POSTGRES_USER=silid
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=silid
POSTGRES_PORT=5432
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=local-development-only
AIRFLOW_ADMIN_EMAIL=admin@example.com
